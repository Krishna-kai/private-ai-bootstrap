---
interface Props {
  title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root, [data-theme="dark"] {
        --bg: #1b1815;
        --text: #eee7dd;
        --text-muted: #9c9186;
        --accent: #c98a5e;
        --surface: rgba(255,255,255,0.05);
        --surface-hover: rgba(255,255,255,0.08);
        --border: rgba(255,255,255,0.1);
        --radius: 12px;
      }

      [data-theme="light"] {
        --bg: #faf8f5;
        --text: #2b2420;
        --text-muted: #7a6f63;
        --accent: #8a5a3b;
        --surface: rgba(0,0,0,0.03);
        --surface-hover: rgba(0,0,0,0.05);
        --border: rgba(0,0,0,0.08);
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      body { min-height: 100vh; display: flex; flex-direction: column; }

      a { color: var(--text); }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 640px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 0;
        width: 100%;
      }

      .site-nav__home {
        font-weight: 600;
        font-size: 1.05rem;
        text-decoration: none;
        letter-spacing: 0.01em;
      }

      .theme-btn {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 50%;
        width: 2.1rem;
        height: 2.1rem;
        color: var(--text);
        cursor: pointer;
        font-size: 0.95rem;
      }
      .theme-btn:hover { background: var(--surface-hover); }

      main.page {
        flex: 1;
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        padding: 2rem 1.25rem 3rem;
      }

      .site-footer {
        border-top: 1px solid var(--border);
      }
      .site-footer__inner {
        max-width: 640px;
        margin: 0 auto;
        padding: 1.25rem 1.25rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <nav class="site-nav" aria-label="Site">
      <a class="site-nav__home" href="/">yourdomain</a>
      <button class="theme-btn" id="theme-toggle" aria-label="Toggle theme"><span id="theme-icon">&#9789;</span></button>
    </nav>

    <main class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        &copy; {currentYear} yourdomain.com
      </div>
    </footer>

    <script>
      const themeToggle = document.getElementById('theme-toggle')!;
      const themeIcon = document.getElementById('theme-icon')!;

      function setTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        themeIcon.innerHTML = theme === 'dark' ? '&#9789;' : '&#9788;';
        localStorage.setItem('site-theme', theme);
      }

      setTheme(localStorage.getItem('site-theme') || 'dark');

      themeToggle.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        setTheme(current === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
