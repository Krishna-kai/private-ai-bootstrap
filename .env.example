# Copy to .env and fill in. Replace every "yourdomain.com" below with your
# real domain (must already be an active zone on Cloudflare).

# Ollama model tag to run. Size to your GPU/CPU's actual RAM - start small
# (e.g. a 4B model) and go bigger once you've confirmed the wiring works.
OLLAMA_MODEL=

# Cloudflare Tunnel token - Zero Trust dashboard -> Networks -> Tunnels ->
# Create a tunnel -> Docker connector -> copy the token (the long string in
# the `cloudflared tunnel run --token ...` command it shows you).
CLOUDFLARE_TUNNEL_TOKEN=

# Keep false except for the one-time OpenWebUI bootstrap run where you create
# the admin + user accounts. Flip back to false immediately after - signup
# stays closed the rest of the time, accounts are created by hand.
ENABLE_SIGNUP=false

# Signs OpenWebUI session cookies. Generate once with: openssl rand -hex 32
# Leave this blank and OpenWebUI generates a new random key on every
# container restart, silently logging everyone out each time.
WEBUI_SECRET_KEY=

# Set to "user" only during the one-time bootstrap run (ENABLE_SIGNUP=true).
# OpenWebUI only auto-promotes the very first account ever created to admin -
# every signup after that defaults to role "pending" and can't chat until
# manually approved in the Admin Panel. Unset (or "pending") the rest of the
# time.
DEFAULT_USER_ROLE=

# The real public URL this instance is reachable at, e.g.
# https://chat.yourdomain.com. Used for CORS and for generating correct
# links (shares, password resets) instead of an internal container address.
WEBUI_URL=http://localhost:3000

# What the login page calls itself - shows as "Sign in to {this} (Open WebUI)".
WEBUI_NAME=Private ChatGPT

# Pin these for reproducible builds instead of always pulling latest/main -
# optional, upstream defaults shown.
OLLAMA_DOCKER_TAG=latest
WEBUI_DOCKER_TAG=main
