---
import Base from '../layouts/Base.astro';
---

<Base title="yourdomain.com">
  <h1>Welcome.</h1>
  <p style="color: var(--text-muted); font-size: 1.05rem; margin: 0.75rem 0 2rem;">
    Replace this with your real site. This placeholder just proves the
    Cloudflare Pages deploy works before you build the real thing.
  </p>

  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Private Chat</h2>
    <p style="color: var(--text-muted); margin-bottom: 1rem;">Your own private AI assistant, running on your own box.</p>
    <a
      href="https://chat.yourdomain.com"
      style="display: inline-block; padding: 0.7rem 1.5rem; border-radius: 999px; background: var(--accent); color: #fff; text-decoration: none; font-weight: 600; font-size: 0.95rem;"
    >
      Open the chat &rarr;
    </a>
  </div>
</Base>
